# Local PostgreSQL container
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5433

# Application database connection
DATABASE_URL=postgresql://waypoint:replace_with_local_password@localhost:5433/waypoint

# Temporary server-only identity used until authentication is implemented
WAYPOINT_DEV_USER_ID=00000000-0000-4000-8000-000000000001
